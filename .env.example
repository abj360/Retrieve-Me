# Copy to .env and adjust; .env itself is gitignored and must never be committed.

RETRIEVAL_QDRANT_URL=http://qdrant:6333
RETRIEVAL_REDIS_URL=redis://redis:6379
RETRIEVAL_QDRANT_COLLECTION=chunks
RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CACHE_TTL_SECONDS=300

RETRIEVAL_LOG_LEVEL=INFO

RETRIEVAL_PIPELINE_CONFIG_PATH=src/config/pipeline.yaml

RETRIEVAL_DEFAULT_TOP_K=10
